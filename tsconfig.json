{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/react"],
    "jsx": "react-jsx",
  },
  "plugins": [
    {
      "name": "next",
    },
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "*.mts",
    "*.ts",
    "**/*.mjs",
    "*.mjs",
  ],
  "exclude": ["node_modules"],
}
